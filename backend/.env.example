# ── LLM (simplify step + NuggetBot chat) ────────────────────────────────
# Leave GROQ_API_KEY blank to run fully free with the deterministic fallback.
# Get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# LLM_PROVIDER is auto: "groq" if GROQ_API_KEY is set, else "deterministic".
# Set to "ollama" for local dev with a local model.
# LLM_PROVIDER=groq

# Local dev only (Ollama):
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma2:9b

# ── App ──────────────────────────────────────────────────────────────────
DEMO_MODE=true
# Comma-separated allowed CORS origins (the Vercel preview/prod URL is allowed
# automatically via a *.vercel.app regex).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
SECRET_KEY=change-me-in-production

# ── Narration (Edge TTS) ─────────────────────────────────────────────────
EDGE_TTS_VOICE=en-US-AndrewNeural
EDGE_TTS_RATE=+0%

# ── Optional content monitor (off by default) ────────────────────────────
MONITOR_ENABLED=false
MONITOR_SOURCE_URL=
MONITOR_INTERVAL_HOURS=24

# ── Database (defaults to local SQLite) ──────────────────────────────────
# DATABASE_URL=sqlite:///./video_nuggets.db
